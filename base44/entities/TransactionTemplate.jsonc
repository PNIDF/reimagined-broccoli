{
  "name": "TransactionTemplate",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "title": "Libell\u00e9",
      "description": "Libell\u00e9 de la transaction r\u00e9currente"
    },
    "amount": {
      "type": "number",
      "title": "Montant",
      "description": "Montant positif (le signe est d\u00e9termin\u00e9 par le type)"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "debit",
        "credit"
      ],
      "default": "debit"
    },
    "category": {
      "type": "string",
      "title": "Cat\u00e9gorie",
      "enum": [
        "courses",
        "loisirs",
        "transport",
        "logement",
        "sante",
        "salaire",
        "restaurant",
        "shopping",
        "factures",
        "autre"
      ],
      "default": "autre"
    },
    "merchant": {
      "type": "string",
      "title": "Commer\u00e7ant",
      "description": "B\u00e9n\u00e9ficiaire ou commer\u00e7ant habituel"
    },
    "account_id": {
      "type": "string",
      "title": "Compte par d\u00e9faut",
      "description": "ID du compte \u00e0 utiliser par d\u00e9faut"
    },
    "recurring_day": {
      "type": "number",
      "title": "Jour de pr\u00e9l\u00e8vement",
      "description": "Jour du mois o\u00f9 survient le pr\u00e9l\u00e8vement r\u00e9current (1-31)"
    },
    "last_alert_period": {
      "type": "string",
      "title": "Derni\u00e8re p\u00e9riode d'alerte",
      "description": "Mois (YYYY-MM) de la derni\u00e8re alerte envoy\u00e9e pour \u00e9viter les doublons"
    }
  },
  "required": [
    "label",
    "amount",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}